# Chép file này thành .env (KHÔNG đưa .env lên Git) rồi điền giá trị.
# Trên Cloudflare Pages: Settings → Environment variables.

# Địa chỉ web thật (dùng cho sitemap, Open Graph)
SITE_URL=https://tomcashop.pages.dev

# URL Web App của Google Apps Script nhận đơn (xem docs/huong-dan-apps-script.md).
# Để trống = chế độ thử: đơn không gửi đi đâu.
PUBLIC_ORDER_ENDPOINT=

# Thông tin chuyển khoản để tạo mã VietQR ở trang cảm ơn.
# Mã ngân hàng theo VietQR, ví dụ: VCB, TCB, MB, ACB, VPB, BIDV, ICB (VietinBank)...
PUBLIC_BANK_ID=
PUBLIC_BANK_ACCOUNT=
PUBLIC_BANK_ACCOUNT_NAME=
