---
const muc = [
  { icon: '💵', tieuDe: 'Thanh toán COD', phu: 'Nhận hàng mới trả tiền', url: '/chinh-sach/thanh-toan' },
  { icon: '📦', tieuDe: 'Kiểm tra hàng', phu: 'Trước khi thanh toán', url: '/chinh-sach/van-chuyen' },
  { icon: '🚚', tieuDe: 'Miễn phí ship', phu: 'Đơn từ 2 sản phẩm', url: '/chinh-sach/van-chuyen' },
  { icon: '🛠️', tieuDe: 'Bảo hành 3 tháng', phu: 'Giao 3–5 ngày', url: '/chinh-sach/bao-hanh' },
];
---
<div class="grid grid-cols-2 gap-3 md:grid-cols-4">
  {muc.map((m) => (
    <a href={m.url} class="flex items-center gap-3 rounded-2xl bg-white p-4 shadow-md transition hover:shadow-lg">
      <span class="text-2xl" aria-hidden="true">{m.icon}</span>
      <span><b class="block text-sm">{m.tieuDe}</b><span class="text-xs text-slate-500">{m.phu}</span></span>
    </a>
  ))}
</div>
