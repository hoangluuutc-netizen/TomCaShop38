---
// Hình minh họa tạm khi sản phẩm chưa có ảnh thật (lấy từ Mẫu A).
import type { Hinh } from '../lib/san-pham';
interface Props { hinh: Hinh; mau?: string; class?: string; nhan?: string }
const { hinh, mau = '#2B8FD6', class: lop = 'w-20 h-20', nhan, ...khac } = Astro.props as Props & Record<string, unknown>;
---
<svg viewBox="0 0 64 64" class={lop} style={`color:${mau}`} role="img" aria-label={nhan || undefined} aria-hidden={nhan === '' ? 'true' : undefined} {...khac}>
  {hinh === 'vali' && (<>
    <rect x="24" y="4" width="16" height="8" rx="3" fill="none" stroke="currentColor" stroke-width="4" />
    <rect x="12" y="11" width="40" height="44" rx="9" fill="currentColor" />
    <rect x="20" y="17" width="4" height="32" rx="2" fill="#fff" opacity=".5" />
    <rect x="40" y="17" width="4" height="32" rx="2" fill="#fff" opacity=".5" />
    <circle cx="20" cy="59" r="4" fill="#334155" /><circle cx="44" cy="59" r="4" fill="#334155" />
  </>)}
  {hinh === 'cap' && (<>
    <path d="M22 12a10 10 0 0 1 20 0" fill="none" stroke="currentColor" stroke-width="4" />
    <rect x="10" y="12" width="44" height="46" rx="10" fill="currentColor" />
    <rect x="10" y="12" width="44" height="18" rx="10" fill="#fff" opacity=".35" />
    <rect x="28" y="26" width="8" height="8" rx="2" fill="#fff" />
  </>)}
  {hinh === 'hop' && (<>
    <rect x="8" y="20" width="48" height="34" rx="8" fill="currentColor" />
    <rect x="8" y="14" width="48" height="12" rx="6" fill="currentColor" opacity=".7" />
    <circle cx="22" cy="38" r="4" fill="#fff" /><circle cx="42" cy="38" r="4" fill="#fff" />
    <path d="M26 45q6 5 12 0" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round" />
  </>)}
</svg>
