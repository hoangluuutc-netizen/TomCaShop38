---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import DanhSachLoc from '../components/DanhSachLoc.astro';
import { laySanPham } from '../lib/san-pham';
const ds = laySanPham();
---
<Base title="Tất cả sản phẩm" description="Tất cả vali, cặp da và đồ dùng cho bé tại TomcaShop38. Lọc theo tuổi, giá, màu, kích thước.">
  <Breadcrumb muc={[{ ten: 'Tất cả sản phẩm' }]} />
  <div class="khung mt-3">
    <h1 class="text-2xl font-bold text-xanh-800 md:text-3xl" data-tieu-de-tim>Tất cả sản phẩm</h1>
  </div>
  <DanhSachLoc ds={ds} hienLoai />
  <script>
    const q = new URLSearchParams(location.search).get('q');
    if (q) {
      const h = document.querySelector('[data-tieu-de-tim]')!;
      h.textContent = `Kết quả cho "${q}"`;
      document.title = `Tìm "${q}" | TomcaShop38`;
    }
  </script>
</Base>
