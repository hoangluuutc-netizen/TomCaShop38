---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CaBaby from '../components/CaBaby.astro';
import CamKet from '../components/CamKet.astro';
import { SHOP } from '../lib/shop';
---
<Base title="Giới thiệu TomCaShop" description="TomCaShop bán vali, cặp da và đồ dùng cho bé 3–15 tuổi, giao toàn quốc. Thông tin người bán và cam kết với bố mẹ.">
  <Breadcrumb muc={[{ ten: 'Giới thiệu' }]} />
  <div class="khung mt-4 max-w-3xl">
    <div class="items-center gap-8 rounded-3xl bg-hong-50 p-6 md:flex md:p-10">
      <CaBaby class="mx-auto w-32 shrink-0 md:mx-0" />
      <div class="mt-4 md:mt-0">
        <h1 class="text-2xl font-extrabold text-xanh-800 md:text-3xl">Xin chào, TomCaShop đây!</h1>
        <p class="mt-2 leading-relaxed text-slate-700">TomCaShop bán vali, cặp da và đồ dùng cho bé từ 3 đến 15 tuổi. Tôm xanh và Cá hồng trong logo là hai người bạn nhỏ, cùng mascot Cá Baby đồng hành với bé trong mỗi chuyến đi và mỗi ngày đến lớp.</p>
        <!-- [Câu chuyện thương hiệu: chờ chủ shop kể, Claude viết lại] -->
      </div>
    </div>
    <div class="mt-8"><CamKet /></div>
    <section class="mt-8 rounded-3xl border border-xanh-100 p-6">
      <h2 class="text-xl font-extrabold text-xanh-800">Thông tin người bán</h2>
      <dl class="mt-3 grid gap-2 text-sm sm:grid-cols-[160px_1fr]">
        <dt class="text-slate-500">Người bán</dt><dd class="font-medium">{SHOP.nguoiBan}</dd>
        <dt class="text-slate-500">Địa chỉ</dt><dd class="font-medium">{SHOP.diaChi}</dd>
        <dt class="text-slate-500">Điện thoại / Zalo</dt><dd class="font-medium"><a href={`tel:${SHOP.dienThoaiSo}`} class="underline">{SHOP.dienThoai}</a></dd>
        <dt class="text-slate-500">Fanpage</dt><dd class="font-medium">{SHOP.fanpage}</dd>
        <dt class="text-slate-500">Giờ làm việc</dt><dd class="font-medium">{SHOP.gioLamViec}</dd>
      </dl>
    </section>
  </div>
</Base>
